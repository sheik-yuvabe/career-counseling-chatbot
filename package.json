{
  "name": "yuvanext-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @yuvanext/api dev",
    "build": "tsup apps/api/src/server.ts --format esm --platform node --target node22 --out-dir apps/api/dist --clean --external express --external cors --external helmet --external pino --external swagger-ui-express --external zod --external @asteasolutions/zod-to-openapi",
    "start": "node apps/api/dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "supabase init",
    "db:login": "supabase login",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:lint": "supabase db lint --linked",
    "db:types": "supabase gen types typescript --linked --schema assessment,recommendation,knowledge,counselor,safety_private,operations > packages/database/src/database.types.ts",
    "db:generate-migration": "node scripts/generate-supabase-migration.mjs",
    "db:validate-migration": "node scripts/validate-phase-a-migration.mjs"
  },
  "devDependencies": {
    "@dbml/core": "^8.3.1",
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "supabase": "^2.109.1",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
