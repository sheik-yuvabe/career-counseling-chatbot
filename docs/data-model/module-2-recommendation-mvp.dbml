// YuvaNext Phase A MVP - Module 2 - Recommendation
// 10 owned tables with complete target fields. External tables are key-only relationship stubs.
// Generated by scripts/generate-data-model-dbml.ps1.

// EXTERNAL RELATIONSHIP STUBS - NOT OWNED BY THIS MODULE

Table assessment.profile_snapshots {
  id uuid [pk, note: 'External relationship key; full table belongs to another module']
}

Table auth.users {
  id uuid [pk, note: 'External relationship key; full table belongs to another module']
}

Table knowledge.aid_schemes {
  id uuid [pk, note: 'External relationship key; full table belongs to another module']
}

Table knowledge.careers {
  id uuid [pk, note: 'External relationship key; full table belongs to another module']
}

Table knowledge.colleges {
  id uuid [pk, note: 'External relationship key; full table belongs to another module']
}

Table knowledge.education_routes {
  id uuid [pk, note: 'External relationship key; full table belongs to another module']
}

Table knowledge.pathways {
  id uuid [pk, note: 'External relationship key; full table belongs to another module']
}

Table knowledge.stream_options {
  id uuid [pk, note: 'External relationship key; full table belongs to another module']
}

// MODULE-OWNED TABLES

Table recommendation.matching_configurations {
  id uuid [pk, note: 'PK']
  configuration_key text [not null, note: 'e.g. career_match, college_rank, aid_rank']
  version text [not null, note: 'Unique with key']
  status text [not null, note: 'draft, active, retired']
  algorithm_version text [not null, note: 'Required']
  interest_weight numeric(6,5) [note: 'Nullable by kind']
  values_weight numeric(6,5) [note: 'Nullable by kind']
  feasibility_weight numeric(6,5) [note: 'Nullable by kind']
  context_weight numeric(6,5) [note: 'Nullable by kind']
  rounding_scale smallint [not null, note: 'Required']
  riasec_tie_order char(1)[] [note: 'Must equal approved six-letter permutation']
  rules_json jsonb [not null, note: 'Versioned bounded kind-specific rules']
  approved_by uuid [ref: > auth.users.id, note: 'Staff Auth ID']
  approved_at timestamptz [note: 'Nullable until active']
  created_at timestamptz [not null, note: 'Required']

  indexes {
    (configuration_key, version) [unique]
  }
}

Table recommendation.feasibility_rules {
  id uuid [pk, note: 'PK']
  configuration_id uuid [not null, ref: > recommendation.matching_configurations.id, note: 'FK']
  segment text [not null, note: 'Required']
  marks_band text [not null, note: 'Approved band or unknown']
  education_route_id uuid [not null, ref: > knowledge.education_routes.id, note: 'FK to knowledge route']
  reachability numeric(4,2) [not null, note: 'Check values approved by config, initially 0.30, 0.65, 1.00']
  reason_key text [note: 'Approved explanation key']
  priority smallint [not null, note: 'Resolve overlapping rules deterministically']
}

Table recommendation.recommendation_runs {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK to auth.users; authorized lookup']
  profile_snapshot_id uuid [not null, ref: > assessment.profile_snapshots.id, note: 'FK to assessment.profile_snapshots']
  kind text [not null, note: 'career, stream, pathway, college, aid']
  configuration_id uuid [not null, ref: > recommendation.matching_configurations.id, note: 'FK']
  algorithm_version text [not null, note: 'Required']
  weights_version text [not null, note: 'Required where applicable']
  source_data_versions_json jsonb [not null, note: 'Required map of dataset versions']
  request_context_json jsonb [note: 'Bounded filters/state selection, no raw chat']
  status text [not null, note: 'running, completed, failed']
  input_hash text [not null, note: 'Required before calculation']
  output_hash text [not null, note: 'Required when completed']
  error_code text [note: 'Nullable safe internal code']
  created_at timestamptz [not null, note: 'Required']
  completed_at timestamptz [note: 'Nullable']
}

Table recommendation.recommendation_rings {
  id uuid [pk, note: 'PK']
  recommendation_run_id uuid [not null, ref: > recommendation.recommendation_runs.id, note: 'FK']
  ring_code text [not null, note: 'inner, middle, outer']
  display_order smallint [not null, note: '1, 2, 3']
  rule_version text [not null, note: 'Required']
  reason_template_key text [note: 'Approved generic explanation key']

  indexes {
    (recommendation_run_id, ring_code) [unique]
  }
}

Table recommendation.recommendation_items {
  id uuid [pk, note: 'PK']
  recommendation_run_id uuid [not null, ref: > recommendation.recommendation_runs.id, note: 'FK']
  ring_id uuid [ref: > recommendation.recommendation_rings.id, note: 'Nullable FK']
  career_id uuid [ref: > knowledge.careers.id, note: 'Nullable FK to knowledge career']
  pathway_id uuid [ref: > knowledge.pathways.id, note: 'Nullable FK to knowledge pathway']
  stream_option_id uuid [ref: > knowledge.stream_options.id, note: 'Nullable FK to stream option']
  college_id uuid [ref: > knowledge.colleges.id, note: 'Nullable FK to college']
  aid_scheme_id uuid [ref: > knowledge.aid_schemes.id, note: 'Nullable FK to aid scheme']
  rank smallint [not null, note: 'Positive, unique within run']
  fit_score numeric(8,6) [note: 'Nullable; check 0..1']
  interest_fit numeric(8,6) [note: 'Nullable; check 0..1']
  values_fit numeric(8,6) [note: 'Nullable; check 0..1']
  feasibility_score numeric(8,6) [note: 'Nullable; check 0..1']
  context_boost numeric(8,6) [note: 'Nullable/config bounded']
  likelihood_label text [note: 'Aid only: likely, check_conditions, explore']
  fit_explanation_json jsonb [not null, note: 'Typed calculation evidence']
  ring_reason_key text [note: 'Nullable approved reason']
  entity_snapshot_json jsonb [note: 'Minimal approved display snapshot, versioned']
  entity_dataset_version text [not null, note: 'Required']
  created_at timestamptz [not null, note: 'Required']

  indexes {
    (recommendation_run_id, rank) [unique]
  }
}

Table recommendation.plan_templates {
  id uuid [pk, note: 'PK']
  template_key text [not null, note: 'Unique with version']
  segment text [not null, note: 'Required']
  plan_type text [not null, note: 'exploration, pathway, career_90_day, backup_route']
  version text [not null, note: 'Required']
  status text [not null, note: 'draft, approved, retired']
  selection_rules_json jsonb [note: 'Typed deterministic rules']
  approved_by uuid [ref: > auth.users.id, note: 'Staff Auth ID']
  approved_at timestamptz [note: 'Nullable']

  indexes {
    (template_key, version) [unique]
  }
}

Table recommendation.plan_template_steps {
  id uuid [pk, note: 'PK']
  plan_template_id uuid [not null, ref: > recommendation.plan_templates.id, note: 'FK']
  step_order smallint [not null, unique, note: 'Positive, unique per template']
  time_window text [not null, note: 'e.g. days 1-30, 31-60, 61-90']
  action_key text [not null, note: 'Approved action template']
  completion_evidence_type text [note: 'Optional non-sensitive evidence category']
  is_optional boolean [not null, note: 'Required']

  indexes {
    (plan_template_id, step_order) [unique]
  }
}

Table recommendation.generated_plans {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK to Auth user']
  profile_snapshot_id uuid [not null, ref: > assessment.profile_snapshots.id, note: 'FK']
  recommendation_run_id uuid [ref: > recommendation.recommendation_runs.id, note: 'Nullable FK']
  plan_template_id uuid [not null, ref: > recommendation.plan_templates.id, note: 'FK']
  plan_version integer [not null, note: 'Increasing per user/type']
  target_entity_type text [note: 'career/pathway/stream']
  target_entity_id uuid [note: 'Application-validated target']
  input_hash text [not null, note: 'Required']
  output_hash text [not null, note: 'Required']
  created_at timestamptz [not null, note: 'Required']
}

Table recommendation.generated_plan_steps {
  id uuid [pk, note: 'PK']
  generated_plan_id uuid [not null, ref: > recommendation.generated_plans.id, note: 'FK']
  source_template_step_id uuid [not null, ref: > recommendation.plan_template_steps.id, note: 'FK']
  step_order smallint [not null, note: 'Unique within plan']
  time_window text [not null, note: 'Required']
  action_text text [not null, note: 'Deterministic approved template fill']
  action_metadata_json jsonb [note: 'Bounded IDs/links only']

  indexes {
    (generated_plan_id, step_order) [unique]
  }
}

Table recommendation.missions {
  id uuid [pk, note: 'PK']
  generated_plan_id uuid [not null, ref: > recommendation.generated_plans.id, note: 'FK']
  mission_order smallint [not null, note: 'Required']
  mission_text text [not null, note: 'Approved deterministic template output']
  mission_type text [not null, note: 'research, conversation, observation, practice']
  created_at timestamptz [not null, note: 'Required']
}
