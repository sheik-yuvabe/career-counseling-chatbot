  algorithm_version text [not null, note: 'Required']
  weights_version text [not null, note: 'Required where applicable']
  source_data_versions_json jsonb [not null, note: 'Required map of dataset versions']
  request_context_json jsonb [note: 'Bounded filters/state selection, no raw chat']
  status text [not null, note: 'running, completed, failed']
  input_hash text [not null, note: 'Required before calculation']
  output_hash text [not null, note: 'Required when completed']
  error_code text [note: 'Nullable safe internal code']
  created_at timestamptz [not null, note: 'Required']
  completed_at timestamptz [note: 'Nullable']
}

