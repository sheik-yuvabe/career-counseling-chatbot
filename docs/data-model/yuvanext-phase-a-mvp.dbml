// YuvaNext Phase A MVP - complete field-level ERD
// 69 target-compatible project tables plus external Supabase auth.users.
// Generated by scripts/generate-data-model-dbml.ps1 from the target module Markdown and validated relationship metadata.

Table auth.users {
  id uuid [pk, note: 'Supabase-managed external identity']
}

// MODULE 1 - ASSESSMENT (15 TABLES)

Table assessment.user_profiles {
  user_id uuid [pk, ref: > auth.users.id, note: 'PK, FK to auth.users(id) on delete cascade']
  first_name text [not null, note: 'Required after onboarding; trimmed; bounded length']
  age_at_onboarding smallint [note: 'Check 12..100; under-12 flow creates no profile']
  age_band text [not null, note: 'Check approved bands; snapshot of routing input']
  city text [not null, note: 'Required, bounded']
  state text [not null, note: 'State/UT name as supplied by the user; no code conversion during onboarding']
  country_code char(2) [note: 'Default IN']
  segment text [not null, note: 'explorer, pathfinder, launcher']
  self_stage text [note: 'Approved education-stage code']
  wants_aid boolean [note: 'Default false']
  profile_status text [not null, note: 'active, deletion_pending, deleted']
  created_at timestamptz [not null, note: 'Required']
  updated_at timestamptz [not null, note: 'Required']
  deleted_at timestamptz [note: 'Nullable']
}

Table assessment.journey_sessions {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK to auth.users']
  anonymous_session_id uuid [note: 'Nullable FK for merge trace']
  channel text [not null, note: 'Phase A web']
  status text [not null, note: 'active, paused, completed, expired, abandoned']
  started_at timestamptz [not null, note: 'Required']
  last_seen_at timestamptz [not null, note: 'Required']
  expires_at timestamptz [not null, note: 'Required']
  completed_at timestamptz [note: 'Nullable']
}

Table assessment.guardian_consents {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK to auth.users; required']
  consent_type text [not null, note: 'guardian for minors; self consent can be added if required']
  guardian_phone_hash text [not null, note: 'Required; keyed hash recommended']
  guardian_phone_last4 char(4) [note: 'Masked staff display only']
  status text [not null, note: 'pending, granted, declined, expired, revoked']
  text_version text [not null, note: 'Required']
  requested_at timestamptz [not null, note: 'Required']
  verified_at timestamptz [note: 'Nullable']
  declined_at timestamptz [note: 'Nullable']
  expired_at timestamptz [note: 'Nullable']
  revoked_at timestamptz [note: 'Nullable']
  provider_reference_hash text [note: 'Nullable; no provider payload']
  created_at timestamptz [not null, note: 'Required']
}

Table assessment.intake_question_sets {
  id uuid [pk, note: 'PK']
  segment text [not null, note: 'Approved segment']
  version text [not null, note: 'Unique with segment']
  language text [not null, note: 'Phase A en']
  status text [not null, note: 'draft, approved, retired']
  effective_from timestamptz [not null, note: 'Required for approved set']
  retired_at timestamptz [note: 'Nullable']
  created_at timestamptz [not null, note: 'Required']

  indexes {
    (segment, version) [unique]
  }
}

Table assessment.intake_questions {
  id uuid [pk, note: 'PK']
  question_set_id uuid [not null, ref: > assessment.intake_question_sets.id, note: 'FK; required']
  question_key text [not null, note: 'Stable semantic key']
  display_order smallint [not null, unique, note: 'Positive; unique within set']
  prompt_text text [note: 'Approved text']
  response_type text [not null, note: 'single_choice, multi_choice, short_text']
  options_json jsonb [note: 'Zod-validated bounded options']
  is_sensitive boolean [note: 'Controls logging/display']
  is_required boolean [not null, note: 'Required']
}

Table assessment.intake_answers {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK to Auth user']
  session_id uuid [not null, ref: > assessment.journey_sessions.id, note: 'FK to assessment.journey_sessions']
  question_id uuid [not null, ref: > assessment.intake_questions.id, note: 'FK']
  question_set_version text [not null, note: 'Denormalized audit value']
  answer_json jsonb [not null, note: 'Zod-validated typed answer']
  answered_at timestamptz [not null, note: 'Required']

  indexes {
    (user_id, session_id, question_id) [unique]
  }
}

Table assessment.assessment_definitions {
  id uuid [pk, note: 'PK']
  instrument_code text [not null, unique, note: 'Unique: ip_60, mini_ip_30, photo_ip, wip, mini_ipip, aptitude']
  name text [not null, note: 'Required']
  construct text [not null, note: 'interest, work_values, big_five, aptitude']
  status text [not null, note: 'active, inactive']
  created_at timestamptz [not null, note: 'Required']
}

Table assessment.assessment_versions {
  id uuid [pk, note: 'PK']
  definition_id uuid [not null, ref: > assessment.assessment_definitions.id, note: 'FK']
  version text [not null, note: 'Unique within definition']
  language text [note: 'en; future reviewed languages']
  age_min smallint [note: 'Nullable']
  age_max smallint [note: 'Nullable']
  item_count smallint [not null, note: 'Required']
  batch_size smallint [note: 'Explorer 5, otherwise 10 as configured']
  scoring_algorithm_version text [not null, note: 'Required']
  content_license_ref text [not null, note: 'Required before production approval']
  review_status text [not null, note: 'mock, draft, approved, retired']
  effective_from timestamptz [note: 'Nullable']
  retired_at timestamptz [note: 'Nullable']
  created_at timestamptz [not null, note: 'Required']

  indexes {
    (definition_id, version) [unique]
  }
}

Table assessment.assessment_items {
  id uuid [pk, note: 'PK']
  assessment_version_id uuid [not null, ref: > assessment.assessment_versions.id, note: 'FK']
  item_key text [not null, note: 'Unique within version']
  display_order smallint [not null, note: 'Unique within version']
  item_type text [not null, note: 'likert, photo_pair, forced_choice, mcq, qc']
  prompt_text text [note: 'Approved/mock content']
  prompt_asset_ref text [note: 'Nullable storage/catalog reference']
  scale_code text [note: 'RIASEC/value/trait/subtype; nullable for QC']
  is_reverse_scored boolean [note: 'Default false']
  is_qc boolean [note: 'Default false']
  qc_rule_json jsonb [note: 'Nullable; typed/versioned']
  is_tie_break boolean [note: 'Default false']
  review_status text [note: 'mock, draft, approved, retired']
  created_at timestamptz [not null, note: 'Required']

  indexes {
    (assessment_version_id, item_key) [unique]
  }
}

Table assessment.assessment_item_options {
  id uuid [pk, note: 'PK']
  item_id uuid [not null, ref: > assessment.assessment_items.id, note: 'FK']
  option_key text [not null, note: 'Unique within item']
  display_order smallint [not null, note: 'Required']
  label_text text [note: 'Nullable for image-only choice']
  asset_ref text [note: 'Nullable']
  score_scale_code text [note: 'Nullable']
  score_delta numeric [note: 'Nullable; e.g. photo choice +2']
  is_correct boolean [note: 'Nullable; restricted for aptitude items']
  scoring_metadata_json jsonb [note: 'Typed; nullable']

  indexes {
    (item_id, option_key) [unique]
  }
}

Table assessment.assessment_runs {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK to Auth user']
  journey_session_id uuid [not null, ref: > assessment.journey_sessions.id, note: 'FK to assessment.journey_sessions']
  assessment_version_id uuid [not null, ref: > assessment.assessment_versions.id, note: 'FK; frozen at start']
  segment text [note: 'Snapshot at start']
  status text [not null, note: 'created, active, paused, completed, scored, abandoned']
  current_position smallint [note: 'Non-negative']
  started_at timestamptz [not null, note: 'Required']
  last_answered_at timestamptz [note: 'Nullable']
  completed_at timestamptz [note: 'Nullable']
  scored_at timestamptz [note: 'Nullable']
  resume_expires_at timestamptz [note: 'Start/last activity plus 14-day rule']
  attempt_number smallint [not null, note: 'Positive']
  created_at timestamptz [not null, note: 'Required']
}

Table assessment.assessment_responses {
  id uuid [pk, note: 'PK']
  assessment_run_id uuid [not null, ref: > assessment.assessment_runs.id, note: 'FK; required']
  item_id uuid [not null, ref: > assessment.assessment_items.id, note: 'FK; required']
  selected_option_id uuid [ref: > assessment.assessment_item_options.id, note: 'Nullable FK']
  response_value smallint [note: 'Nullable; check 1..5 for Likert']
  response_json jsonb [note: 'Nullable; only for approved structured types']
  latency_ms integer [note: 'Non-negative, capped']
  client_answer_id uuid [not null, unique, note: 'Unique idempotency identifier']
  answered_at timestamptz [not null, note: 'Required']
  received_at timestamptz [not null, note: 'Required']

  indexes {
    (assessment_run_id, item_id) [unique]
  }
}

Table assessment.assessment_results {
  id uuid [pk, note: 'PK']
  assessment_run_id uuid [not null, unique, ref: > assessment.assessment_runs.id, note: 'Unique FK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK; denormalized for authorized lookup']
  instrument_code text [not null, note: 'Required']
  instrument_version text [not null, note: 'Required']
  algorithm_version text [not null, note: 'Required']
  raw_scores_json jsonb [note: 'Zod-validated']
  normalized_scores_json jsonb [note: 'Zod-validated, nullable by construct']
  result_code text [not null, note: 'Holland code where applicable']
  confidence text [note: 'normal, soft']
  close_scores boolean [note: 'Default false']
  qc_summary_json jsonb [note: 'Restricted bounded summary']
  input_hash text [not null, note: 'Required']
  output_hash text [not null, note: 'Required']
  created_at timestamptz [not null, note: 'Required']
}

Table assessment.profile_snapshots {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK']
  profile_version integer [not null, note: 'Increasing per user']
  segment text [not null, note: 'Required']
  age_band text [not null, note: 'Required']
  city text [not null, note: 'Required']
  state text [not null, note: 'Required full-text state/UT value captured in the snapshot']
  self_stage text [not null, note: 'Required']
  wants_aid boolean [not null, note: 'Required']
  intake_summary_json jsonb [not null, note: 'Versioned DTO']
  result_summary_json jsonb [not null, note: 'Versioned DTO']
  algorithm_version text [not null, note: 'Required']
  snapshot_schema_version integer [not null, note: 'Required']
  payload_hash text [not null, note: 'Required']
  created_at timestamptz [not null, note: 'Required']

  indexes {
    (user_id, profile_version) [unique]
  }
}

Table assessment.profile_snapshot_results {
  profile_snapshot_id uuid [not null, ref: > assessment.profile_snapshots.id, note: 'FK to profile snapshot']
  assessment_result_id uuid [not null, ref: > assessment.assessment_results.id, note: 'FK to assessment result']
  result_role text [not null, note: 'interest, values, big_five, aptitude']
  display_order smallint [not null, note: 'Positive']

  indexes {
    (profile_snapshot_id, assessment_result_id) [pk]
  }
}

// MODULE 3 - KNOWLEDGE (18 TABLES)

Table knowledge.knowledge_sources {
  id uuid [pk, note: 'PK']
  source_key text [not null, unique, note: 'Unique stable key']
  name text [not null, note: 'Required']
  source_type text [not null, note: 'government, official_portal, institution, onet, manual_review']
  base_url text [note: 'Nullable; validated URL']
  publisher text [not null, note: 'Required']
  license_ref text [note: 'Nullable in mock data; required before publication when applicable']
  trust_level text [not null, note: 'authoritative, reviewed_secondary, internal_reviewed']
  status text [not null, note: 'active, inactive']
  created_at timestamptz [not null, note: 'Required']
  updated_at timestamptz [not null, note: 'Required']
}

Table knowledge.dataset_versions {
  id uuid [pk, note: 'PK']
  source_id uuid [not null, ref: > knowledge.knowledge_sources.id, note: 'FK']
  dataset_key text [not null, note: 'e.g. careers, colleges_south_india']
  version text [not null, note: 'Unique with dataset key']
  checksum text [not null, note: 'Required']
  record_count integer [note: 'Non-negative']
  import_status text [not null, note: 'staged, validated, published, rejected, superseded']
  validation_report_json jsonb [note: 'Bounded/versioned']
  imported_at timestamptz [not null, note: 'Required']
  published_at timestamptz [note: 'Nullable']
  created_by uuid [ref: > auth.users.id, note: 'Staff Auth ID or service actor']

  indexes {
    (dataset_key, version) [unique]
  }
}

Table knowledge.education_routes {
  id uuid [pk, note: 'PK']
  route_code text [not null, unique, note: 'Unique']
  title text [not null, note: 'Required']
  route_level text [not null, note: 'school_stream, certificate, iti, diploma, degree, postgraduate, open']
  description text [note: 'Approved']
  publication_status text [not null, note: 'Required']
}

Table knowledge.careers {
  id uuid [pk, note: 'PK']
  onet_code text [unique, note: 'Nullable unique external key']
  nco_code text [note: 'Nullable future external key']
  slug text [not null, unique, note: 'Unique public slug']
  title text [not null, note: 'Required']
  short_description text [note: 'Approved bounded prose']
  domain_code text [not null, note: 'Indexed constrained code']
  primary_education_route_id uuid [ref: > knowledge.education_routes.id, note: 'FK to education route']
  is_curated boolean [not null, note: 'Required']
  publication_status text [not null, note: 'draft, review, published, retired']
  dataset_version_id uuid [not null, ref: > knowledge.dataset_versions.id, note: 'FK; required']
  published_at timestamptz [note: 'Nullable']
  retired_at timestamptz [note: 'Nullable']
  created_at timestamptz [not null, note: 'Required']
  updated_at timestamptz [not null, note: 'Required until publication/retirement']
}

Table knowledge.career_interest_profiles {
  career_id uuid [pk, ref: > knowledge.careers.id, note: 'PK/FK']
  realistic numeric(6,5) [not null, note: 'Check 0..1']
  investigative numeric(6,5) [not null, note: 'Check 0..1']
  artistic numeric(6,5) [not null, note: 'Check 0..1']
  social numeric(6,5) [not null, note: 'Check 0..1']
  enterprising numeric(6,5) [not null, note: 'Check 0..1']
  conventional numeric(6,5) [not null, note: 'Check 0..1']
  high_point_code char(1) [note: 'Check R/I/A/S/E/C']
  profile_version text [not null, note: 'Required']
  dataset_version_id uuid [not null, ref: > knowledge.dataset_versions.id, note: 'FK']
}

Table knowledge.career_value_profiles {
  career_id uuid [pk, ref: > knowledge.careers.id, note: 'PK/FK']
  achievement numeric(6,5) [not null, note: 'Check 0..1']
  independence numeric(6,5) [not null, note: 'Check 0..1']
  recognition numeric(6,5) [not null, note: 'Check 0..1']
  relationships numeric(6,5) [not null, note: 'Check 0..1']
  support numeric(6,5) [not null, note: 'Check 0..1']
  working_conditions numeric(6,5) [not null, note: 'Check 0..1']
  profile_version text [not null, note: 'Required']
  dataset_version_id uuid [not null, ref: > knowledge.dataset_versions.id, note: 'FK']
}

Table knowledge.career_profiles {
  career_id uuid [pk, ref: > knowledge.careers.id, note: 'PK/FK']
  image_ref text [note: 'Nullable approved asset']
  salary_entry_band text [note: 'Nullable; reviewed structured band']
  salary_note text [note: 'Nullable approved caveat']
  skills text[] [note: 'Bounded approved list']
  next_role_3yr text [note: 'Nullable']
  progression_note text [note: 'Nullable']
  review_status text [not null, note: 'draft, reviewed, retired']
  last_reviewed_at timestamptz [note: 'Nullable']
  reviewed_by uuid [ref: > auth.users.id, note: 'Nullable staff Auth ID']
}

Table knowledge.pathways {
  id uuid [pk, note: 'PK']
  pathway_code text [not null, unique, note: 'Unique']
  title text [not null, note: 'Required']
  description text [note: 'Approved']
  education_route_id uuid [not null, ref: > knowledge.education_routes.id, note: 'FK']
  duration_band text [note: 'Nullable']
  backup_route_note text [note: 'Nullable approved prose']
  publication_status text [not null, note: 'Required']
  dataset_version_id uuid [not null, ref: > knowledge.dataset_versions.id, note: 'FK']
}

Table knowledge.career_pathways {
  career_id uuid [not null, ref: > knowledge.careers.id, note: 'FK']
  pathway_id uuid [not null, ref: > knowledge.pathways.id, note: 'FK']
  relationship_type text [not null, note: 'primary, alternative, vocational']
  display_order smallint [not null, note: 'Positive']

  indexes {
    (career_id, pathway_id) [pk]
  }
}

Table knowledge.stream_options {
  id uuid [pk, note: 'PK']
  stream_code text [not null, unique, note: 'Unique stable code; required']
  title text [not null, note: 'Required']
  description text [not null, note: 'Approved description; required']
  status text [not null, note: 'Required']
}

Table knowledge.stream_maps {
  id uuid [pk, note: 'PK']
  top_two_code text [not null, note: 'Approved top-two RIASEC code; required']
  version text [not null, note: 'Required']
  dataset_version_id uuid [not null, ref: > knowledge.dataset_versions.id, note: 'FK; required']
  status text [not null, note: 'Required']

  indexes {
    (top_two_code, version) [unique]
  }
}

Table knowledge.stream_map_items {
  map_id uuid [not null, ref: > knowledge.stream_maps.id, note: 'FK; required; part of composite PK']
  stream_option_id uuid [not null, ref: > knowledge.stream_options.id, note: 'FK; required; part of composite PK']
  rank smallint [not null, unique, note: 'Positive and unique within map']
  reason_key text [not null, note: 'Approved reason key; required']

  indexes {
    (map_id, stream_option_id) [pk]
    (map_id, rank) [unique]
  }
}

Table knowledge.colleges {
  id uuid [pk, note: 'PK']
  external_code text [note: 'Nullable source-specific key']
  name text [not null, note: 'Required']
  city text [not null, note: 'Required']
  state text [not null, note: 'Indexed official full state/UT name']
  institution_type text [not null, note: 'e.g. university, college, polytechnic, ITI, open']
  tier smallint [note: 'Nullable approved project tier; never inferred by AI']
  admission_route text [note: 'Nullable approved summary']
  fees_band text [note: 'Nullable reviewed band']
  website_url text [note: 'Nullable official URL']
  verification_status text [not null, note: 'unverified, verified, stale, retired']
  last_verified_at timestamptz [note: 'Nullable']
  dataset_version_id uuid [not null, ref: > knowledge.dataset_versions.id, note: 'FK']
  created_at timestamptz [not null, note: 'Required']
  updated_at timestamptz [not null, note: 'Required']
}

Table knowledge.disciplines {
  id uuid [pk, note: 'PK']
  discipline_code text [not null, unique, note: 'Unique stable code; required']
  title text [not null, note: 'Required']
  domain_code text [not null, note: 'Controlled domain code; required']
  status text [not null, note: 'Required']
}

Table knowledge.college_programs {
  id uuid [pk, note: 'PK']
  college_id uuid [not null, ref: > knowledge.colleges.id, note: 'FK']
  discipline_id uuid [not null, ref: > knowledge.disciplines.id, note: 'FK']
  program_name text [not null, note: 'Required']
  qualification_level text [not null, note: 'Required']
  duration_band text [note: 'Nullable']
  admission_route text [note: 'Nullable']
  fees_band text [note: 'Nullable']
  verification_status text [not null, note: 'Required']
  last_verified_at timestamptz [note: 'Nullable']
  dataset_version_id uuid [not null, ref: > knowledge.dataset_versions.id, note: 'FK']
}

Table knowledge.pathway_disciplines {
  pathway_id uuid [not null, ref: > knowledge.pathways.id, note: 'FK; required; part of composite PK']
  discipline_id uuid [not null, ref: > knowledge.disciplines.id, note: 'FK; required; part of composite PK']
  relevance_weight numeric(6,5) [not null, note: 'Check 0..1; required']
  mapping_version text [not null, note: 'Required']

  indexes {
    (pathway_id, discipline_id) [pk]
  }
}

Table knowledge.aid_schemes {
  id uuid [pk, note: 'PK']
  aid_code text [not null, unique, note: 'Unique stable code']
  name text [not null, note: 'Required']
  provider_type text [note: 'central, state, CSR, institution, meta']
  provider text [not null, note: 'Required']
  level text [not null, note: 'Approved education level']
  states text[] [note: 'Empty means nationwide only when explicitly defined']
  eligibility_summary text [note: 'Approved non-verdict prose']
  benefit_summary text [note: 'Approved']
  amount_text text [note: 'Nullable; preserve source wording']
  application_url text [not null, note: 'Official validated URL']
  portal_name text [note: 'Nullable']
  apply_window_start date [note: 'Nullable']
  apply_window_end date [note: 'Nullable']
  verification_status text [not null, note: 'verified, stale, retired']
  last_verified_at timestamptz [not null, note: 'Required for user publication']
  dataset_version_id uuid [not null, ref: > knowledge.dataset_versions.id, note: 'FK']
}

Table knowledge.aid_criteria {
  id uuid [pk, note: 'PK']
  aid_scheme_id uuid [not null, ref: > knowledge.aid_schemes.id, note: 'FK']
  criterion_type text [not null, note: 'state, level, marks_band, income_band, category, disability, gender or approved type']
  operator text [not null, note: 'equals, in, min, max, unknown_check']
  value_json jsonb [not null, note: 'Typed by criterion type']
  is_required boolean [not null, note: 'Required']
  source_text text [note: 'Exact/approved supporting summary']
  criterion_version text [not null, note: 'Required']
}

// MODULE 2 - RECOMMENDATION (10 TABLES)

Table recommendation.matching_configurations {
  id uuid [pk, note: 'PK']
  configuration_key text [not null, note: 'e.g. career_match, college_rank, aid_rank']
  version text [not null, note: 'Unique with key']
  status text [not null, note: 'draft, active, retired']
  algorithm_version text [not null, note: 'Required']
  interest_weight numeric(6,5) [note: 'Nullable by kind']
  values_weight numeric(6,5) [note: 'Nullable by kind']
  feasibility_weight numeric(6,5) [note: 'Nullable by kind']
  context_weight numeric(6,5) [note: 'Nullable by kind']
  rounding_scale smallint [not null, note: 'Required']
  riasec_tie_order char(1)[] [note: 'Must equal approved six-letter permutation']
  rules_json jsonb [not null, note: 'Versioned bounded kind-specific rules']
  approved_by uuid [ref: > auth.users.id, note: 'Staff Auth ID']
  approved_at timestamptz [note: 'Nullable until active']
  created_at timestamptz [not null, note: 'Required']

  indexes {
    (configuration_key, version) [unique]
  }
}

Table recommendation.feasibility_rules {
  id uuid [pk, note: 'PK']
  configuration_id uuid [not null, ref: > recommendation.matching_configurations.id, note: 'FK']
  segment text [not null, note: 'Required']
  marks_band text [not null, note: 'Approved band or unknown']
  education_route_id uuid [not null, ref: > knowledge.education_routes.id, note: 'FK to knowledge route']
  reachability numeric(4,2) [not null, note: 'Check values approved by config, initially 0.30, 0.65, 1.00']
  reason_key text [note: 'Approved explanation key']
  priority smallint [not null, note: 'Resolve overlapping rules deterministically']
}

Table recommendation.recommendation_runs {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK to auth.users; authorized lookup']
