// YuvaNext Phase A MVP - Module 5 - Safety and Operations
// 16 owned tables with complete target fields. External tables are key-only relationship stubs.
// Generated by scripts/generate-data-model-dbml.ps1.

// EXTERNAL RELATIONSHIP STUBS - NOT OWNED BY THIS MODULE

Table assessment.assessment_runs {
  id uuid [pk, note: 'External relationship key; full table belongs to another module']
}

Table assessment.journey_sessions {
  id uuid [pk, note: 'External relationship key; full table belongs to another module']
}

Table assessment.profile_snapshots {
  id uuid [pk, note: 'External relationship key; full table belongs to another module']
}

Table auth.users {
  id uuid [pk, note: 'External relationship key; full table belongs to another module']
}

Table counselor.conversations {
  id uuid [pk, note: 'External relationship key; full table belongs to another module']
}

// MODULE-OWNED TABLES

Table safety_private.safety_policy_versions {
  id uuid [pk, note: 'PK']
  version text [not null, unique, note: 'Unique']
  status text [not null, note: 'draft, approved, retired']
  policy_hash text [not null, note: 'Required']
  source_document_ref text [not null, note: 'Required before production approval']
  effective_from timestamptz [note: 'Nullable']
  approved_by uuid [ref: > auth.users.id, note: 'Authorized staff Auth ID']
  approved_at timestamptz [note: 'Nullable']
  created_at timestamptz [not null, note: 'Required']
}

Table safety_private.approved_safety_messages {
  id uuid [pk, note: 'PK']
  policy_version_id uuid [not null, ref: > safety_private.safety_policy_versions.id, note: 'FK']
  message_key text [not null, note: 'Unique within policy/language']
  tier text [not null, note: 'tier_1, tier_2, tier_3']
  language text [not null, note: 'Required']
  content text [note: 'Human-approved exact copy']
  helpline_refs_json jsonb [note: 'Approved IDs/URLs/numbers']
  status text [not null, note: 'approved, retired']
  content_hash text [not null, note: 'Required']

  indexes {
    (policy_version_id, message_key, language) [unique]
  }
}

Table safety_private.safety_rule_sets {
  id uuid [pk, note: 'PK']
  policy_version_id uuid [not null, ref: > safety_private.safety_policy_versions.id, note: 'FK']
  version text [not null, unique, note: 'Unique']
  rule_type text [not null, note: 'deterministic, classifier, hybrid']
  rules_json jsonb [not null, note: 'Restricted/versioned fixture/config']
  classifier_name text [note: 'Nullable approved classifier']
  classifier_version text [note: 'Nullable']
  status text [not null, note: 'draft, approved, retired']
  approved_at timestamptz [note: 'Nullable']
}

Table safety_private.safety_events {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK to Auth user']
  session_id uuid [ref: > assessment.journey_sessions.id, note: 'Journey/application session reference']
  conversation_id uuid [ref: > counselor.conversations.id, note: 'Nullable Module 4 ID, app validated']
  assessment_run_id uuid [ref: > assessment.assessment_runs.id, note: 'Nullable Module 1 ID, app validated']
  source_event_id uuid [not null, unique, note: 'Unique idempotency key']
  trigger_type text [note: 'message, user_request, assessment_event, approved type']
  tier text [note: 'Nullable when no event is persisted; tier_1..3']
  decision text [not null, note: 'triggered, not_triggered, manual_review']
  rule_set_id uuid [not null, ref: > safety_private.safety_rule_sets.id, note: 'FK']
  approved_message_id uuid [ref: > safety_private.approved_safety_messages.id, note: 'Nullable FK']
  trigger_excerpt_ciphertext bytea [note: 'Nullable; encrypted only when policy requires excerpt']
  encryption_key_version text [not null, note: 'Required with ciphertext']
  trigger_hash text [not null, note: 'Required for integrity/dedup where safe']
  pause_journey boolean [not null, note: 'Required']
  create_handoff boolean [not null, note: 'Required']
  occurred_at timestamptz [not null, note: 'Required']
  created_at timestamptz [not null, note: 'Required']
}

Table safety_private.handoffs {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK']
  safety_event_id uuid [ref: > safety_private.safety_events.id, note: 'Nullable FK for user-requested non-safety handoff']
  reason text [not null, note: 'user_request, tier_1, tier_2, tier_3, low_confidence']
  priority smallint [not null, note: 'Deterministic by policy']
  profile_snapshot_id uuid [ref: > assessment.profile_snapshots.id, note: 'Nullable Module 1 ID']
  recommendation_ids uuid[] [note: 'Bounded Module 2 IDs']
  conversation_id uuid [ref: > counselor.conversations.id, note: 'Nullable Module 4 ID']
  contact_available boolean [note: 'No contact value stored here']
  packet_snapshot_json jsonb [note: 'Minimal restricted versioned packet']
  packet_hash text [not null, note: 'Required']
  status text [not null, note: 'queued, alerted, actioned, closed, cancelled']
  queued_at timestamptz [not null, note: 'Required']
  alerted_at timestamptz [note: 'Nullable']
  actioned_at timestamptz [note: 'Nullable']
  closed_at timestamptz [note: 'Nullable']
}

Table safety_private.alert_deliveries {
  id uuid [pk, note: 'PK']
  handoff_id uuid [not null, ref: > safety_private.handoffs.id, note: 'FK']
  channel text [not null, note: 'Approved alert adapter']
  destination_ref_hash text [note: 'No plaintext destination']
  provider_reference_hash text [note: 'Nullable']
  status text [not null, note: 'queued, sent, delivered, failed']
  attempt_number smallint [not null, note: 'Positive']
  error_code text [note: 'Nullable safe code']
  queued_at timestamptz [not null, note: 'Required']
  completed_at timestamptz [note: 'Nullable']

  indexes {
    (handoff_id, channel, attempt_number) [unique]
  }
}

Table operations.staff_profiles {
  user_id uuid [pk, ref: > auth.users.id, note: 'PK/FK to auth.users']
  display_name text [not null, note: 'Required']
  staff_status text [not null, note: 'invited, active, suspended, disabled']
  mfa_required boolean [not null, note: 'True for all Phase A staff']
  created_at timestamptz [not null, note: 'Required']
  updated_at timestamptz [not null, note: 'Required']
}

Table operations.staff_role_assignments {
  id uuid [pk, note: 'PK']
  staff_user_id uuid [not null, ref: > operations.staff_profiles.user_id, note: 'FK']
  role text [not null, note: 'counselor, supervisor, auditor, data_reviewer']
  scope_json jsonb [note: 'Bounded state/program scope; nullable']
  granted_by uuid [not null, ref: > auth.users.id, note: 'Staff Auth ID']
  granted_at timestamptz [not null, note: 'Required']
  expires_at timestamptz [note: 'Nullable']
  revoked_at timestamptz [note: 'Nullable']
}

Table safety_private.handoff_actions {
  id uuid [pk, note: 'PK']
  handoff_id uuid [not null, ref: > safety_private.handoffs.id, note: 'FK']
  actor_staff_id uuid [not null, ref: > operations.staff_profiles.user_id, note: 'FK to operations staff profile']
  action_type text [not null, note: 'viewed, claimed, contact_attempted, actioned, closed, approved type']
  action_category text [note: 'Nullable approved category']
  note_ciphertext bytea [note: 'Nullable restricted encrypted note']
  encryption_key_version text [not null, note: 'Required with note']
  occurred_at timestamptz [not null, note: 'Required']
}

Table operations.audit_events {
  id uuid [pk, note: 'PK']
  actor_type text [not null, note: 'user, staff, service, job']
  actor_id uuid [note: 'Nullable for system actor']
  action text [not null, note: 'Approved catalog']
  target_type text [not null, note: 'Required']
  target_id uuid [note: 'Nullable when aggregate action']
  request_correlation_id uuid [not null, note: 'Required']
  safe_metadata_json jsonb [note: 'PII-free bounded metadata']
  ip_hash text [note: 'Nullable under approved retention policy']
  occurred_at timestamptz [not null, note: 'Required']
}

Table operations.privacy_jobs {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK to Auth user']
  job_type text [not null, note: 'export, delete']
  requested_by uuid [not null, ref: > auth.users.id, note: 'Authorized principal/staff ID']
  authorization_method text [note: 'Approved verification method']
  status text [not null, note: 'queued, running, completed, failed, cancelled']
  deadline_at timestamptz [not null, note: 'Required']
  result_asset_ref text [note: 'Nullable private export asset']
  result_expires_at timestamptz [note: 'Nullable']
  attempt_count smallint [note: 'Non-negative']
  error_code text [note: 'Nullable safe code']
  requested_at timestamptz [not null, note: 'Required']
  completed_at timestamptz [note: 'Nullable']
}

Table operations.privacy_job_steps {
  id uuid [pk, note: 'PK']
  privacy_job_id uuid [not null, ref: > operations.privacy_jobs.id, note: 'FK; required']
  module_code text [not null, note: 'Required']
  status text [not null, note: 'Required']
  attempt_count smallint [not null, note: 'Non-negative; required']
  started_at timestamptz [note: 'Nullable']
  completed_at timestamptz [note: 'Nullable']
  error_code text [note: 'Nullable safe code']

  indexes {
    (privacy_job_id, module_code) [unique]
  }
}

Table operations.analytics_events {
  id uuid [pk, note: 'PK']
  event_name text [not null, note: 'Approved funnel/event catalog']
  anonymous_analytics_id uuid [not null, note: 'Rotatable/non-auth identifier per policy']
  segment text [note: 'Nullable']
  instrument_code text [note: 'Nullable']
  journey_step smallint [note: 'Nullable']
  state text [note: 'Nullable full state/UT name if approved']
  duration_ms integer [note: 'Nullable non-negative']
  count_value integer [note: 'Nullable']
  safety_tier text [note: 'Nullable; never trigger text']
  properties_json jsonb [not null, note: 'Strict allowlist, no free text']
  occurred_at timestamptz [not null, note: 'Required']
}

Table operations.evaluation_cases {
  id uuid [pk, note: 'PK']
  case_key text [not null, note: 'Unique with version']
  version text [not null, note: 'Required']
  module_code text [not null, note: 'm1 through m5 or integrated']
  category text [not null, note: 'scoring, matching, retrieval, grounding, safety, privacy, accessibility, load']
  severity text [note: 'blocking, warning']
  fixture_refs_json jsonb [note: 'Versioned repository/data refs']
  input_json jsonb [note: 'Synthetic/approved test input']
  expected_json jsonb [not null, note: 'Exact output/invariants']
  assertions_json jsonb [note: 'Machine-readable assertions']
  status text [not null, note: 'draft, active, retired']
  created_at timestamptz [not null, note: 'Required']

  indexes {
    (case_key, version) [unique]
  }
}

Table operations.evaluation_runs {
  id uuid [pk, note: 'PK']
  run_type text [not null, note: 'ci, manual, scheduled, release']
  git_revision text [not null, note: 'Required']
  environment text [not null, note: 'test/staging; production only if approved non-PII checks']
  fixture_versions_json jsonb [not null, note: 'Required']
  status text [not null, note: 'running, passed, failed, cancelled']
  started_at timestamptz [not null, note: 'Required']
  completed_at timestamptz [note: 'Nullable']
  summary_json jsonb [note: 'Counts/metrics only']
}

Table operations.evaluation_results {
  id uuid [pk, note: 'PK']
  evaluation_run_id uuid [not null, ref: > operations.evaluation_runs.id, note: 'FK']
  evaluation_case_id uuid [not null, ref: > operations.evaluation_cases.id, note: 'FK']
  status text [not null, note: 'passed, failed, error, skipped']
  actual_json jsonb [note: 'Bounded synthetic result/evidence']
  metrics_json jsonb [note: 'Typed metrics']
  failure_codes text[] [note: 'Approved codes']
  duration_ms integer [not null, note: 'Non-negative']
  created_at timestamptz [not null, note: 'Required']

  indexes {
    (evaluation_run_id, evaluation_case_id) [unique]
  }
}
