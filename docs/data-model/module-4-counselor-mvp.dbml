// YuvaNext Phase A MVP - Module 4 - AI Counselor
// 10 owned tables with complete target fields. External tables are key-only relationship stubs.
// Generated by scripts/generate-data-model-dbml.ps1.

// EXTERNAL RELATIONSHIP STUBS - NOT OWNED BY THIS MODULE

Table assessment.assessment_runs {
  id uuid [pk, note: 'External relationship key; full table belongs to another module']
}

Table assessment.profile_snapshots {
  id uuid [pk, note: 'External relationship key; full table belongs to another module']
}

Table auth.users {
  id uuid [pk, note: 'External relationship key; full table belongs to another module']
}

Table recommendation.recommendation_items {
  id uuid [pk, note: 'External relationship key; full table belongs to another module']
}

Table recommendation.recommendation_runs {
  id uuid [pk, note: 'External relationship key; full table belongs to another module']
}

// MODULE-OWNED TABLES

Table counselor.conversations {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK to auth.users']
  profile_snapshot_id uuid [ref: > assessment.profile_snapshots.id, note: 'Nullable FK to current snapshot used at start']
  segment text [not null, note: 'Snapshot for behavior/copy']
  status text [not null, note: 'active, paused, completed, safety_locked, deleted']
  channel text [note: 'Phase A web']
  language text [not null, note: 'Phase A en']
  ai_mode text [not null, note: 'enabled, degraded, disabled']
  started_at timestamptz [not null, note: 'Required']
  last_turn_at timestamptz [note: 'Nullable']
  completed_at timestamptz [note: 'Nullable']
  created_at timestamptz [not null, note: 'Required']
}

Table counselor.conversation_messages {
  id uuid [pk, note: 'PK']
  conversation_id uuid [not null, ref: > counselor.conversations.id, note: 'FK']
  turn_number integer [not null, unique, note: 'Positive, unique within conversation']
  role text [not null, note: 'user, assistant, system_copy']
  content text [not null, note: 'Bounded; may contain personal free text']
  content_language text [not null, note: 'Required']
  message_status text [not null, note: 'received, generating, completed, blocked, failed']
  provider_message_id_hash text [note: 'Nullable; never raw provider secret']
  prompt_version text [note: 'Nullable for assistant turn']
  model_name text [note: 'Nullable for AI-generated turn']
  flags text[] [note: 'Approved codes only']
  created_at timestamptz [not null, note: 'Required']

  indexes {
    (conversation_id, turn_number, role) [unique]
  }
}

Table counselor.conversation_summaries {
  id uuid [pk, note: 'PK']
  conversation_id uuid [not null, ref: > counselor.conversations.id, note: 'FK']
  from_turn integer [not null, note: 'Required']
  to_turn integer [not null, note: 'Required; greater/equal from']
  summary_json jsonb [not null, note: 'Typed facts/intents, not unrestricted hidden profile']
  summary_version text [not null, note: 'Required']
  source_hash text [not null, note: 'Required']
  created_at timestamptz [not null, note: 'Required']
}

Table counselor.tool_calls {
  id uuid [pk, note: 'PK']
  conversation_id uuid [not null, ref: > counselor.conversations.id, note: 'FK']
  request_message_id uuid [not null, ref: > counselor.conversation_messages.id, note: 'FK to assistant generating turn']
  tool_name text [not null, note: 'Approved registry only']
  tool_schema_version text [not null, note: 'Required']
  input_json jsonb [not null, note: 'Zod-validated and size bounded']
  input_hash text [not null, note: 'Required']
  output_snapshot_json jsonb [note: 'Bounded approved result or reference snapshot']
  output_hash text [note: 'Nullable until success']
  source_versions_json jsonb [not null, note: 'Required when successful']
  status text [not null, note: 'requested, running, succeeded, failed, timed_out']
  latency_ms integer [note: 'Nullable, non-negative']
  error_code text [note: 'Nullable safe code']
  started_at timestamptz [not null, note: 'Required']
  completed_at timestamptz [note: 'Nullable']
}

Table counselor.message_grounding {
  id uuid [pk, note: 'PK']
  assistant_message_id uuid [not null, ref: > counselor.conversation_messages.id, note: 'FK']
  tool_call_id uuid [not null, ref: > counselor.tool_calls.id, note: 'FK']
  entity_type text [not null, note: 'career, college, aid, pathway, degree, exam or approved type']
  entity_id uuid [not null, note: 'Owning-module ID; application validated']
  display_name text [not null, note: 'Exact allowed name']
  allowed_numbers_json jsonb [note: 'Bounded approved values']
  allowed_urls text[] [note: 'Exact approved URLs']
  source_version text [not null, note: 'Required']
}

Table counselor.journey_states {
  user_id uuid [pk, ref: > auth.users.id, note: 'PK/FK to Auth user']
  conversation_id uuid [ref: > counselor.conversations.id, note: 'Nullable FK']
  current_step smallint [not null, note: 'Check 1..5']
  current_state_key text [not null, note: 'Approved state machine key']
  profile_snapshot_id uuid [ref: > assessment.profile_snapshots.id, note: 'Nullable FK']
  current_recommendation_id uuid [ref: > recommendation.recommendation_runs.id, note: 'Nullable Module 2 ID; app validated']
  current_assessment_run_id uuid [ref: > assessment.assessment_runs.id, note: 'Nullable Module 1 ID; app validated']
  is_safety_paused boolean [note: 'Default false']
  state_json jsonb [note: 'Minimal bounded navigation state']
  lock_version integer [note: 'Optimistic concurrency']
  updated_at timestamptz [not null, note: 'Required']
}

Table counselor.journey_events {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK']
  conversation_id uuid [ref: > counselor.conversations.id, note: 'Nullable FK']
  event_type text [not null, note: 'Approved event catalog']
  event_schema_version integer [not null, note: 'Required']
  related_entity_type text [note: 'Nullable']
  related_entity_id uuid [note: 'Nullable']
  metadata_json jsonb [note: 'Non-PII bounded metadata']
  occurred_at timestamptz [not null, note: 'Required']
}

Table counselor.exploration_events {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK']
  conversation_id uuid [ref: > counselor.conversations.id, note: 'Nullable FK']
  recommendation_id uuid [not null, ref: > recommendation.recommendation_runs.id, note: 'Module 2 run ID; app validated']
  recommendation_item_id uuid [ref: > recommendation.recommendation_items.id, note: 'Module 2 item ID; app validated']
  action text [not null, note: 'viewed, compared, selected, deselected, plan_opened']
  occurred_at timestamptz [not null, note: 'Required']
  client_event_id uuid [not null, unique, note: 'Unique idempotency ID']
}

Table counselor.report_snapshots {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK']
  profile_snapshot_id uuid [not null, ref: > assessment.profile_snapshots.id, note: 'FK to assessment snapshot']
  recommendation_ids uuid[] [not null, note: 'Validated Module 2 run IDs']
  exploration_event_ids uuid[] [note: 'Selected relevant events']
  report_schema_version integer [not null, note: 'Required']
  language text [not null, note: 'Required']
  payload_json jsonb [not null, note: 'Complete versioned report DTO']
  payload_hash text [not null, note: 'Required']
  summary_mode text [note: 'template, ai_polished']
  prompt_version text [note: 'Nullable']
  created_at timestamptz [not null, note: 'Required']
}

Table counselor.generated_assets {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK']
  report_snapshot_id uuid [ref: > counselor.report_snapshots.id, note: 'Nullable FK']
  asset_type text [not null, note: 'report_pdf, share_card']
  storage_bucket text [not null, note: 'Approved bucket']
  storage_path text [not null, note: 'Unique opaque path']
  content_hash text [not null, note: 'Required']
  privacy_class text [note: 'private_report, share_safe']
  generation_status text [not null, note: 'queued, generating, ready, failed, expired, deleted']
  expires_at timestamptz [not null, note: 'Required for private download/share link policy']
  created_at timestamptz [not null, note: 'Required']
  deleted_at timestamptz [note: 'Nullable']
}
