// YuvaNext Phase A MVP - Module 1 - Assessment
// 15 owned tables with complete target fields. External tables are key-only relationship stubs.
// Generated by scripts/generate-data-model-dbml.ps1.

// EXTERNAL RELATIONSHIP STUBS - NOT OWNED BY THIS MODULE

Table auth.users {
  id uuid [pk, note: 'External relationship key; full table belongs to another module']
}

// MODULE-OWNED TABLES

Table assessment.user_profiles {
  user_id uuid [pk, ref: > auth.users.id, note: 'PK, FK to auth.users(id) on delete cascade']
  first_name text [not null, note: 'Required after onboarding; trimmed; bounded length']
  age_at_onboarding smallint [note: 'Check 12..100; under-12 flow creates no profile']
  age_band text [not null, note: 'Check approved bands; snapshot of routing input']
  city text [not null, note: 'Required, bounded']
  state text [not null, note: 'State/UT name as supplied by the user; no code conversion during onboarding']
  country_code char(2) [note: 'Default IN']
  segment text [not null, note: 'explorer, pathfinder, launcher']
  self_stage text [note: 'Approved education-stage code']
  wants_aid boolean [note: 'Default false']
  profile_status text [not null, note: 'active, deletion_pending, deleted']
  created_at timestamptz [not null, note: 'Required']
  updated_at timestamptz [not null, note: 'Required']
  deleted_at timestamptz [note: 'Nullable']
}

Table assessment.journey_sessions {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK to auth.users']
  anonymous_session_id uuid [note: 'Nullable FK for merge trace']
  channel text [not null, note: 'Phase A web']
  status text [not null, note: 'active, paused, completed, expired, abandoned']
  started_at timestamptz [not null, note: 'Required']
  last_seen_at timestamptz [not null, note: 'Required']
  expires_at timestamptz [not null, note: 'Required']
  completed_at timestamptz [note: 'Nullable']
}

Table assessment.guardian_consents {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK to auth.users; required']
  consent_type text [not null, note: 'guardian for minors; self consent can be added if required']
  guardian_phone_hash text [not null, note: 'Required; keyed hash recommended']
  guardian_phone_last4 char(4) [note: 'Masked staff display only']
  status text [not null, note: 'pending, granted, declined, expired, revoked']
  text_version text [not null, note: 'Required']
  requested_at timestamptz [not null, note: 'Required']
  verified_at timestamptz [note: 'Nullable']
  declined_at timestamptz [note: 'Nullable']
  expired_at timestamptz [note: 'Nullable']
  revoked_at timestamptz [note: 'Nullable']
  provider_reference_hash text [note: 'Nullable; no provider payload']
  created_at timestamptz [not null, note: 'Required']
}

Table assessment.intake_question_sets {
  id uuid [pk, note: 'PK']
  segment text [not null, note: 'Approved segment']
  version text [not null, note: 'Unique with segment']
  language text [not null, note: 'Phase A en']
  status text [not null, note: 'draft, approved, retired']
  effective_from timestamptz [not null, note: 'Required for approved set']
  retired_at timestamptz [note: 'Nullable']
  created_at timestamptz [not null, note: 'Required']

  indexes {
    (segment, version) [unique]
  }
}

Table assessment.intake_questions {
  id uuid [pk, note: 'PK']
  question_set_id uuid [not null, ref: > assessment.intake_question_sets.id, note: 'FK; required']
  question_key text [not null, note: 'Stable semantic key']
  display_order smallint [not null, unique, note: 'Positive; unique within set']
  prompt_text text [note: 'Approved text']
  response_type text [not null, note: 'single_choice, multi_choice, short_text']
  options_json jsonb [note: 'Zod-validated bounded options']
  is_sensitive boolean [note: 'Controls logging/display']
  is_required boolean [not null, note: 'Required']
}

Table assessment.intake_answers {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK to Auth user']
  session_id uuid [not null, ref: > assessment.journey_sessions.id, note: 'FK to assessment.journey_sessions']
  question_id uuid [not null, ref: > assessment.intake_questions.id, note: 'FK']
  question_set_version text [not null, note: 'Denormalized audit value']
  answer_json jsonb [not null, note: 'Zod-validated typed answer']
  answered_at timestamptz [not null, note: 'Required']

  indexes {
    (user_id, session_id, question_id) [unique]
  }
}

Table assessment.assessment_definitions {
  id uuid [pk, note: 'PK']
  instrument_code text [not null, unique, note: 'Unique: ip_60, mini_ip_30, photo_ip, wip, mini_ipip, aptitude']
  name text [not null, note: 'Required']
  construct text [not null, note: 'interest, work_values, big_five, aptitude']
  status text [not null, note: 'active, inactive']
  created_at timestamptz [not null, note: 'Required']
}

Table assessment.assessment_versions {
  id uuid [pk, note: 'PK']
  definition_id uuid [not null, ref: > assessment.assessment_definitions.id, note: 'FK']
  version text [not null, note: 'Unique within definition']
  language text [note: 'en; future reviewed languages']
  age_min smallint [note: 'Nullable']
  age_max smallint [note: 'Nullable']
  item_count smallint [not null, note: 'Required']
  batch_size smallint [note: 'Explorer 5, otherwise 10 as configured']
  scoring_algorithm_version text [not null, note: 'Required']
  content_license_ref text [not null, note: 'Required before production approval']
  review_status text [not null, note: 'mock, draft, approved, retired']
  effective_from timestamptz [note: 'Nullable']
  retired_at timestamptz [note: 'Nullable']
  created_at timestamptz [not null, note: 'Required']

  indexes {
    (definition_id, version) [unique]
  }
}

Table assessment.assessment_items {
  id uuid [pk, note: 'PK']
  assessment_version_id uuid [not null, ref: > assessment.assessment_versions.id, note: 'FK']
  item_key text [not null, note: 'Unique within version']
  display_order smallint [not null, note: 'Unique within version']
  item_type text [not null, note: 'likert, photo_pair, forced_choice, mcq, qc']
  prompt_text text [note: 'Approved/mock content']
  prompt_asset_ref text [note: 'Nullable storage/catalog reference']
  scale_code text [note: 'RIASEC/value/trait/subtype; nullable for QC']
  is_reverse_scored boolean [note: 'Default false']
  is_qc boolean [note: 'Default false']
  qc_rule_json jsonb [note: 'Nullable; typed/versioned']
  is_tie_break boolean [note: 'Default false']
  review_status text [note: 'mock, draft, approved, retired']
  created_at timestamptz [not null, note: 'Required']

  indexes {
    (assessment_version_id, item_key) [unique]
  }
}

Table assessment.assessment_item_options {
  id uuid [pk, note: 'PK']
  item_id uuid [not null, ref: > assessment.assessment_items.id, note: 'FK']
  option_key text [not null, note: 'Unique within item']
  display_order smallint [not null, note: 'Required']
  label_text text [note: 'Nullable for image-only choice']
  asset_ref text [note: 'Nullable']
  score_scale_code text [note: 'Nullable']
  score_delta numeric [note: 'Nullable; e.g. photo choice +2']
  is_correct boolean [note: 'Nullable; restricted for aptitude items']
  scoring_metadata_json jsonb [note: 'Typed; nullable']

  indexes {
    (item_id, option_key) [unique]
  }
}

Table assessment.assessment_runs {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK to Auth user']
  journey_session_id uuid [not null, ref: > assessment.journey_sessions.id, note: 'FK to assessment.journey_sessions']
  assessment_version_id uuid [not null, ref: > assessment.assessment_versions.id, note: 'FK; frozen at start']
  segment text [note: 'Snapshot at start']
  status text [not null, note: 'created, active, paused, completed, scored, abandoned']
  current_position smallint [note: 'Non-negative']
  started_at timestamptz [not null, note: 'Required']
  last_answered_at timestamptz [note: 'Nullable']
  completed_at timestamptz [note: 'Nullable']
  scored_at timestamptz [note: 'Nullable']
  resume_expires_at timestamptz [note: 'Start/last activity plus 14-day rule']
  attempt_number smallint [not null, note: 'Positive']
  created_at timestamptz [not null, note: 'Required']
}

Table assessment.assessment_responses {
  id uuid [pk, note: 'PK']
  assessment_run_id uuid [not null, ref: > assessment.assessment_runs.id, note: 'FK; required']
  item_id uuid [not null, ref: > assessment.assessment_items.id, note: 'FK; required']
  selected_option_id uuid [ref: > assessment.assessment_item_options.id, note: 'Nullable FK']
  response_value smallint [note: 'Nullable; check 1..5 for Likert']
  response_json jsonb [note: 'Nullable; only for approved structured types']
  latency_ms integer [note: 'Non-negative, capped']
  answered_at timestamptz [not null, note: 'Required']
  received_at timestamptz [not null, note: 'Required']

  indexes {
    (assessment_run_id, item_id) [unique]
  }
}

Table assessment.assessment_results {
  id uuid [pk, note: 'PK']
  assessment_run_id uuid [not null, unique, ref: > assessment.assessment_runs.id, note: 'Unique FK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK; denormalized for authorized lookup']
  instrument_code text [not null, note: 'Required']
  instrument_version text [not null, note: 'Required']
  algorithm_version text [not null, note: 'Required']
  raw_scores_json jsonb [note: 'Zod-validated']
  normalized_scores_json jsonb [note: 'Zod-validated, nullable by construct']
  result_code text [not null, note: 'Holland code where applicable']
  confidence text [note: 'normal, soft']
  close_scores boolean [note: 'Default false']
  qc_summary_json jsonb [note: 'Restricted bounded summary']
  input_hash text [not null, note: 'Required']
  output_hash text [not null, note: 'Required']
  created_at timestamptz [not null, note: 'Required']
}

Table assessment.profile_snapshots {
  id uuid [pk, note: 'PK']
  user_id uuid [not null, ref: > auth.users.id, note: 'FK']
  profile_version integer [not null, note: 'Increasing per user']
  segment text [not null, note: 'Required']
  age_band text [not null, note: 'Required']
  city text [not null, note: 'Required']
  state text [not null, note: 'Required full-text state/UT value captured in the snapshot']
  self_stage text [not null, note: 'Required']
  wants_aid boolean [not null, note: 'Required']
  intake_summary_json jsonb [not null, note: 'Versioned DTO']
  result_summary_json jsonb [not null, note: 'Versioned DTO']
  algorithm_version text [not null, note: 'Required']
  snapshot_schema_version integer [not null, note: 'Required']
  payload_hash text [not null, note: 'Required']
  created_at timestamptz [not null, note: 'Required']

  indexes {
    (user_id, profile_version) [unique]
  }
}

Table assessment.profile_snapshot_results {
  profile_snapshot_id uuid [not null, ref: > assessment.profile_snapshots.id, note: 'FK to profile snapshot']
  assessment_result_id uuid [not null, ref: > assessment.assessment_results.id, note: 'FK to assessment result']
  result_role text [not null, note: 'interest, values, big_five, aptitude']
  display_order smallint [not null, note: 'Positive']

  indexes {
    (profile_snapshot_id, assessment_result_id) [pk]
  }
}
