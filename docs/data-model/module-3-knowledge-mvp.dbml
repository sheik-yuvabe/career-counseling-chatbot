// YuvaNext Phase A MVP - Module 3 - Knowledge
// 18 owned tables with complete target fields. External tables are key-only relationship stubs.
// Generated by scripts/generate-data-model-dbml.ps1.

// EXTERNAL RELATIONSHIP STUBS - NOT OWNED BY THIS MODULE

Table auth.users {
  id uuid [pk, note: 'External relationship key; full table belongs to another module']
}

// MODULE-OWNED TABLES

Table knowledge.knowledge_sources {
  id uuid [pk, note: 'PK']
  source_key text [not null, unique, note: 'Unique stable key']
  name text [not null, note: 'Required']
  source_type text [not null, note: 'government, official_portal, institution, onet, manual_review']
  base_url text [note: 'Nullable; validated URL']
  publisher text [not null, note: 'Required']
  license_ref text [note: 'Nullable in mock data; required before publication when applicable']
  trust_level text [not null, note: 'authoritative, reviewed_secondary, internal_reviewed']
  status text [not null, note: 'active, inactive']
  created_at timestamptz [not null, note: 'Required']
  updated_at timestamptz [not null, note: 'Required']
}

Table knowledge.dataset_versions {
  id uuid [pk, note: 'PK']
  source_id uuid [not null, ref: > knowledge.knowledge_sources.id, note: 'FK']
  dataset_key text [not null, note: 'e.g. careers, colleges_south_india']
  version text [not null, note: 'Unique with dataset key']
  checksum text [not null, note: 'Required']
  record_count integer [note: 'Non-negative']
  import_status text [not null, note: 'staged, validated, published, rejected, superseded']
  validation_report_json jsonb [note: 'Bounded/versioned']
  imported_at timestamptz [not null, note: 'Required']
  published_at timestamptz [note: 'Nullable']
  created_by uuid [ref: > auth.users.id, note: 'Staff Auth ID or service actor']

  indexes {
    (dataset_key, version) [unique]
  }
}

Table knowledge.education_routes {
  id uuid [pk, note: 'PK']
  route_code text [not null, unique, note: 'Unique']
  title text [not null, note: 'Required']
  route_level text [not null, note: 'school_stream, certificate, iti, diploma, degree, postgraduate, open']
  description text [note: 'Approved']
  publication_status text [not null, note: 'Required']
}

Table knowledge.careers {
  id uuid [pk, note: 'PK']
  onet_code text [unique, note: 'Nullable unique external key']
  nco_code text [note: 'Nullable future external key']
  slug text [not null, unique, note: 'Unique public slug']
  title text [not null, note: 'Required']
  short_description text [note: 'Approved bounded prose']
  domain_code text [not null, note: 'Indexed constrained code']
  primary_education_route_id uuid [ref: > knowledge.education_routes.id, note: 'FK to education route']
  is_curated boolean [not null, note: 'Required']
  publication_status text [not null, note: 'draft, review, published, retired']
  dataset_version_id uuid [not null, ref: > knowledge.dataset_versions.id, note: 'FK; required']
  published_at timestamptz [note: 'Nullable']
  retired_at timestamptz [note: 'Nullable']
  created_at timestamptz [not null, note: 'Required']
  updated_at timestamptz [not null, note: 'Required until publication/retirement']
}

Table knowledge.career_interest_profiles {
  career_id uuid [pk, ref: > knowledge.careers.id, note: 'PK/FK']
  realistic numeric(6,5) [not null, note: 'Check 0..1']
  investigative numeric(6,5) [not null, note: 'Check 0..1']
  artistic numeric(6,5) [not null, note: 'Check 0..1']
  social numeric(6,5) [not null, note: 'Check 0..1']
  enterprising numeric(6,5) [not null, note: 'Check 0..1']
  conventional numeric(6,5) [not null, note: 'Check 0..1']
  high_point_code char(1) [note: 'Check R/I/A/S/E/C']
  profile_version text [not null, note: 'Required']
  dataset_version_id uuid [not null, ref: > knowledge.dataset_versions.id, note: 'FK']
}

Table knowledge.career_value_profiles {
  career_id uuid [pk, ref: > knowledge.careers.id, note: 'PK/FK']
  achievement numeric(6,5) [not null, note: 'Check 0..1']
  independence numeric(6,5) [not null, note: 'Check 0..1']
  recognition numeric(6,5) [not null, note: 'Check 0..1']
  relationships numeric(6,5) [not null, note: 'Check 0..1']
  support numeric(6,5) [not null, note: 'Check 0..1']
  working_conditions numeric(6,5) [not null, note: 'Check 0..1']
  profile_version text [not null, note: 'Required']
  dataset_version_id uuid [not null, ref: > knowledge.dataset_versions.id, note: 'FK']
}

Table knowledge.career_profiles {
  career_id uuid [pk, ref: > knowledge.careers.id, note: 'PK/FK']
  image_ref text [note: 'Nullable approved asset']
  salary_entry_band text [note: 'Nullable; reviewed structured band']
  salary_note text [note: 'Nullable approved caveat']
  skills text[] [note: 'Bounded approved list']
  next_role_3yr text [note: 'Nullable']
  progression_note text [note: 'Nullable']
  review_status text [not null, note: 'draft, reviewed, retired']
  last_reviewed_at timestamptz [note: 'Nullable']
  reviewed_by uuid [ref: > auth.users.id, note: 'Nullable staff Auth ID']
}

Table knowledge.pathways {
  id uuid [pk, note: 'PK']
  pathway_code text [not null, unique, note: 'Unique']
  title text [not null, note: 'Required']
  description text [note: 'Approved']
  education_route_id uuid [not null, ref: > knowledge.education_routes.id, note: 'FK']
  duration_band text [note: 'Nullable']
  backup_route_note text [note: 'Nullable approved prose']
  publication_status text [not null, note: 'Required']
  dataset_version_id uuid [not null, ref: > knowledge.dataset_versions.id, note: 'FK']
}

Table knowledge.career_pathways {
  career_id uuid [not null, ref: > knowledge.careers.id, note: 'FK']
  pathway_id uuid [not null, ref: > knowledge.pathways.id, note: 'FK']
  relationship_type text [not null, note: 'primary, alternative, vocational']
  display_order smallint [not null, note: 'Positive']

  indexes {
    (career_id, pathway_id) [pk]
  }
}

Table knowledge.stream_options {
  id uuid [pk, note: 'PK']
  stream_code text [not null, unique, note: 'Unique stable code; required']
  title text [not null, note: 'Required']
  description text [not null, note: 'Approved description; required']
  status text [not null, note: 'Required']
}

Table knowledge.stream_maps {
  id uuid [pk, note: 'PK']
  top_two_code text [not null, note: 'Approved top-two RIASEC code; required']
  version text [not null, note: 'Required']
  dataset_version_id uuid [not null, ref: > knowledge.dataset_versions.id, note: 'FK; required']
  status text [not null, note: 'Required']

  indexes {
    (top_two_code, version) [unique]
  }
}

Table knowledge.stream_map_items {
  map_id uuid [not null, ref: > knowledge.stream_maps.id, note: 'FK; required; part of composite PK']
  stream_option_id uuid [not null, ref: > knowledge.stream_options.id, note: 'FK; required; part of composite PK']
  rank smallint [not null, unique, note: 'Positive and unique within map']
  reason_key text [not null, note: 'Approved reason key; required']

  indexes {
    (map_id, stream_option_id) [pk]
    (map_id, rank) [unique]
  }
}

Table knowledge.colleges {
  id uuid [pk, note: 'PK']
  external_code text [note: 'Nullable source-specific key']
  name text [not null, note: 'Required']
  city text [not null, note: 'Required']
  state text [not null, note: 'Indexed official full state/UT name']
  institution_type text [not null, note: 'e.g. university, college, polytechnic, ITI, open']
  tier smallint [note: 'Nullable approved project tier; never inferred by AI']
  admission_route text [note: 'Nullable approved summary']
  fees_band text [note: 'Nullable reviewed band']
  website_url text [note: 'Nullable official URL']
  verification_status text [not null, note: 'unverified, verified, stale, retired']
  last_verified_at timestamptz [note: 'Nullable']
  dataset_version_id uuid [not null, ref: > knowledge.dataset_versions.id, note: 'FK']
  created_at timestamptz [not null, note: 'Required']
  updated_at timestamptz [not null, note: 'Required']
}

Table knowledge.disciplines {
  id uuid [pk, note: 'PK']
  discipline_code text [not null, unique, note: 'Unique stable code; required']
  title text [not null, note: 'Required']
  domain_code text [not null, note: 'Controlled domain code; required']
  status text [not null, note: 'Required']
}

Table knowledge.college_programs {
  id uuid [pk, note: 'PK']
  college_id uuid [not null, ref: > knowledge.colleges.id, note: 'FK']
  discipline_id uuid [not null, ref: > knowledge.disciplines.id, note: 'FK']
  program_name text [not null, note: 'Required']
  qualification_level text [not null, note: 'Required']
  duration_band text [note: 'Nullable']
  admission_route text [note: 'Nullable']
  fees_band text [note: 'Nullable']
  verification_status text [not null, note: 'Required']
  last_verified_at timestamptz [note: 'Nullable']
  dataset_version_id uuid [not null, ref: > knowledge.dataset_versions.id, note: 'FK']
}

Table knowledge.pathway_disciplines {
  pathway_id uuid [not null, ref: > knowledge.pathways.id, note: 'FK; required; part of composite PK']
  discipline_id uuid [not null, ref: > knowledge.disciplines.id, note: 'FK; required; part of composite PK']
  relevance_weight numeric(6,5) [not null, note: 'Check 0..1; required']
  mapping_version text [not null, note: 'Required']

  indexes {
    (pathway_id, discipline_id) [pk]
  }
}

Table knowledge.aid_schemes {
  id uuid [pk, note: 'PK']
  aid_code text [not null, unique, note: 'Unique stable code']
  name text [not null, note: 'Required']
  provider_type text [note: 'central, state, CSR, institution, meta']
  provider text [not null, note: 'Required']
  level text [not null, note: 'Approved education level']
  states text[] [note: 'Empty means nationwide only when explicitly defined']
  eligibility_summary text [note: 'Approved non-verdict prose']
  benefit_summary text [note: 'Approved']
  amount_text text [note: 'Nullable; preserve source wording']
  application_url text [not null, note: 'Official validated URL']
  portal_name text [note: 'Nullable']
  apply_window_start date [note: 'Nullable']
  apply_window_end date [note: 'Nullable']
  verification_status text [not null, note: 'verified, stale, retired']
  last_verified_at timestamptz [not null, note: 'Required for user publication']
  dataset_version_id uuid [not null, ref: > knowledge.dataset_versions.id, note: 'FK']
}

Table knowledge.aid_criteria {
  id uuid [pk, note: 'PK']
  aid_scheme_id uuid [not null, ref: > knowledge.aid_schemes.id, note: 'FK']
  criterion_type text [not null, note: 'state, level, marks_band, income_band, category, disability, gender or approved type']
  operator text [not null, note: 'equals, in, min, max, unknown_check']
  value_json jsonb [not null, note: 'Typed by criterion type']
  is_required boolean [not null, note: 'Required']
  source_text text [note: 'Exact/approved supporting summary']
  criterion_version text [not null, note: 'Required']
}
