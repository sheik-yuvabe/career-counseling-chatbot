NODE_ENV=development
COUNSELOR_RUNTIME=unconfigured
COUNSELOR_FIXTURE_TOKEN=fixture-token
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Copy these values from the Supabase project dashboard. Never commit real secrets.
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
INTERNAL_API_KEY=replace-with-at-least-32-random-characters

# Use the Session Pooler connection string on IPv4-only networks.
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-your-region.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# AI provider. Use gemini, anthropic, disabled, or auto (Gemini first, then Anthropic).
AI_PROVIDER=gemini

# Optional Gemini integration. Create the server-side key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_TOKENS=700
GEMINI_TIMEOUT_MS=60000
GEMINI_THINKING_LEVEL=minimal

# Optional Claude integration. Both values are required when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=700
ANTHROPIC_TIMEOUT_MS=15000

# Module 5 internal API. AI messages fail closed until the URL is configured and reachable.
SAFETY_SERVICE_URL=
SAFETY_SERVICE_TIMEOUT_MS=5000

# Approved non-safety counselor copy and asset configuration.
COUNSELOR_COPY_VERSION=1
COUNSELOR_WELCOME_EXPLORER=Welcome. I can help you explore your saved career profile and options.
COUNSELOR_WELCOME_PATHFINDER=Welcome. I can help you understand your saved recommendations and next steps.
COUNSELOR_WELCOME_LAUNCHER=Welcome. I can help you review your saved career plan and practical next steps.
COUNSELOR_FALLBACK_COPY=The AI counselor is temporarily unavailable. You can continue exploring your saved recommendations.
COUNSELOR_PRIVATE_REPORT_BUCKET=private-reports
COUNSELOR_SHARE_CARD_BUCKET=share-cards
COUNSELOR_PRIVATE_ASSET_TTL_MS=900000
COUNSELOR_SHARE_ASSET_TTL_MS=86400000
