NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Hosted Supabase project values. Never commit real secrets.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Use the Supabase pooler connection string for the deployed API.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres
DATABASE_SSL=true

# Internal Module 4 -> Module 5 safety service integration.
SAFETY_SERVICE_URL=http://localhost:3001
SAFETY_SERVICE_TOKEN=replace-with-module-5-internal-safety-token
